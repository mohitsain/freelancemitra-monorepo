# Docker Compose - copy to .env and set values
# Used by: docker-compose.yml (frontend + backend + postgres)

# Postgres (backend DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=freelancemitra

# NextAuth (must match between frontend and backend)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars

# OAuth (frontend - from fe-freelancemitra/.env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Backend (optional - for proposal AI, S3 uploads, etc.)
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Temporal (optional - defaults: temporal:7233, default namespace, freelancemitra-task-queue)
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=freelancemitra-task-queue
