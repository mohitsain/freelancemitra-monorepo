# App
DEBUG=false

# PostgreSQL (async)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/freelancemitra

# NextAuth SSO - must match fe-freelancemitra .env (NEXTAUTH_SECRET)
NEXTAUTH_SECRET=your-actual-secret-key
NEXTAUTH_URL=http://localhost:3000

# CORS (comma-separated or leave default)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# S3 (onboarding file uploads; bucket: freelancemitra)
# Option A: Use access keys
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-south-1
# S3_BUCKET=freelancemitra
# Option B: Use CLI profile (e.g. mohit.kumar)
# AWS_PROFILE=mohit.kumar
# AWS_REGION=ap-south-1
# S3_BUCKET=freelancemitra
