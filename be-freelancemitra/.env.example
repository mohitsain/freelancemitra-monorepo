# App
DEBUG=false

# PostgreSQL (async)
DATABASE_URL=URL_TO_BE_SET
# NextAuth SSO - must match fe-freelancemitra .env (NEXTAUTH_SECRET)
NEXTAUTH_SECRET=SECRET_TO_BE_SET
NEXTAUTH_URL=http://localhost:3000

# CORS (comma-separated or leave default)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# S3 (onboarding file uploads; bucket: freelancemitra)
# Option A: Use access keys
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1

# Temporal (optional; defaults: localhost:7233, namespace default, task queue freelancemitra-task-queue)
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=freelancemitra-task-queue
